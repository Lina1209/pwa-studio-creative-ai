# Copy to .env and fill in secrets locally. Never commit .env.
APP_ENV=development
APP_NAME=PWA Studio API
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://lina1209.github.io
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_MAX_CONCURRENT_REQUESTS=4
AI_QUEUE_WAIT_SECONDS=10
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=
# Server-only Supabase service_role key (never use in frontend or commit real values).
SUPABASE_SERVICE_ROLE_KEY=
# Exact owner account email. This address receives admin role; users cannot self-assign it.
OWNER_EMAIL=

# Signed generation quotes require a strong server-only secret (32+ bytes).
PRICING_QUOTE_SIGNING_SECRET=
# Server-owned JSON catalog. Every enabled rule MUST define max_provider_cost_usd
# as a decimal string in USD, derived from the provider's current pricing and
# a conservative per-job cap. Do not copy client-supplied values here.
# Example rule (illustrative only; NOT an approved live price):
# {"version":"operator-approved-v1","rules":[{"job_type":"image_generation","provider":"provider-name","model":"model-name","credits_per_unit":10,"unit_label":"image","min_quantity":1,"max_quantity":1,"max_provider_cost_usd":"0.075"}]}
PRICING_CATALOG_JSON={"version":"unconfigured","rules":[]}


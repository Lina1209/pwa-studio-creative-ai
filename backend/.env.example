# Copy to .env and fill in secrets locally. Never commit .env.
APP_ENV=development
APP_NAME=PWA Studio API
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://lina1209.github.io
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
OPENAI_API_KEY=
# Optional providers (configure only the provider you use):
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Ollama base URL (used only when AI_PROVIDER=ollama)
OLLAMA_API_BASE=http://localhost:11434

# Copy to .env and fill in secrets locally. Never commit .env.
APP_ENV=development
APP_NAME=PWA Studio API
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://lina1209.github.io
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_MAX_CONCURRENT_REQUESTS=4
AI_QUEUE_WAIT_SECONDS=10
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=0
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_BYTES=30000
AI_MAX_REQUESTS_PER_MINUTE_PER_USER=10
AI_MAX_REQUESTS_PER_DAY_PER_USER=100
AI_MAX_REQUESTS_PER_DAY_GLOBAL=2000
# Optional USD warning thresholds for today's recorded AI estimates; blank means unconfigured.
# These thresholds warn at 80% and 100%; they are NOT hard billing caps.
AI_DAILY_BUDGET_USD_DEEPSEEK=
AI_MAX_CONCURRENT_REQUESTS_PER_USER=2
AI_MAX_GLOBAL_CONCURRENT_REQUESTS=16
DEEPSEEK_API_KEY=

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=
# Server-only Supabase service_role key (never use in frontend or commit real values).
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated immutable Supabase Auth user UUIDs allowed to administer the app.
# Obtain each UUID from Supabase Authentication -> Users. Email addresses do NOT grant admin.
# Leave empty until the owner UUID is verified; empty means no admin account is enabled.
OWNER_USER_IDS=

# Signed generation quotes require a strong server-only secret (32+ bytes).
PRICING_QUOTE_SIGNING_SECRET=
# Server-owned JSON catalog. Every enabled rule MUST define max_provider_cost_usd_per_unit
# as a decimal string in USD, derived from the provider's current pricing and
# a conservative per-unit USD cap; the signed quote multiplies it by quantity. Do not copy client-supplied values here.
# Example rule (illustrative only; NOT an approved live price):
# {"version":"operator-approved-v1","rules":[{"job_type":"image_generation","provider":"provider-name","model":"model-name","credits_per_unit":10,"unit_label":"image","min_quantity":1,"max_quantity":1,"max_provider_cost_usd_per_unit":"0.075"}]}
PRICING_CATALOG_JSON={"version":"unconfigured","rules":[]}
# Global daily provider spend and outstanding reservation limits are stored in Supabase,
# not browser or worker environment variables. Configure both only through the
# service-role-only configure_provider_budget_policy RPC after cost review.
# The database policy defaults to disabled; missing limits block billable calls.

# Payment provider runtime is intentionally disabled. Keep disabled until a concrete
# provider adapter, signature verification, credentials, legal review and end-to-end
# tests are complete. Never put provider secrets in frontend variables or Git.
PAYMENT_PROVIDER_RUNTIME_ENABLED=false
PAYMENT_PROVIDER_MODE=test

# Copy to .env and fill in secrets locally. Never commit .env.
APP_ENV=development
APP_NAME=PWA Studio API
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://lina1209.github.io
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=
# Exact owner account email. This address receives admin role; users cannot self-assign it.
OWNER_EMAIL=
